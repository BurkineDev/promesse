generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String        @id @default(uuid())
  email            String        @unique
  password         String
  refreshTokenHash String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  goals        Goal[]
  transactions Transaction[]

  accounts          Account[]
  ledgerTransactions LedgerTransaction[]

}

enum GoalStatus {
  ACTIVE
  ARCHIVED
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
}

model Goal {
  id                String     @id @default(uuid())
  userId            String
  name              String
  status            GoalStatus @default(ACTIVE)

  // Future-ready (not used in MVP logic yet)
  lockedUntil       DateTime?
  targetAmountMinor BigInt?
  targetDate        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id])
  transactions Transaction[]

  @@index([userId])
}

model Transaction {
  id          String          @id @default(uuid())
  userId      String
  goalId      String
  type        TransactionType
  amountMinor BigInt

  note       String?
  createdAt  DateTime @default(now())
  occurredAt DateTime?

  // Idempotency & future internal transfers
  idempotencyKey  String?
  transferGroupId String?

  user User @relation(fields: [userId], references: [id])
  goal Goal @relation(fields: [goalId], references: [id])

  @@index([goalId, createdAt])
  @@index([goalId, type])
  @@index([userId, createdAt])
  @@index([transferGroupId])

  // Enforce idempotency per user (nullable OK in Postgres)
  @@unique([userId, idempotencyKey])
}

// =======================
// Ledger (Double-entry)
// =======================

enum AccountType {
  USER_MAIN
  GOAL
  SYSTEM_CLEARING
  PLATFORM_REVENUE
}

enum EntryDirection {
  DEBIT
  CREDIT
}

enum LedgerTxType {
  LEGACY_DEPOSIT
  LEGACY_WITHDRAWAL
  TRANSFER
  CASHIN
  CASHOUT
  FEE
}

model Account {
  id        String      @id @default(uuid())
  userId    String?
  type      AccountType
  createdAt DateTime    @default(now())

  user      User?       @relation(fields: [userId], references: [id])
  entries   Entry[]

  @@index([userId])
  @@index([type])
}

model LedgerTransaction {
  id             String       @id @default(uuid())
  userId         String?
  type           LedgerTxType
  reference      String?
  idempotencyKey String?
  createdAt      DateTime     @default(now())

  user           User?        @relation(fields: [userId], references: [id])
  entries        Entry[]

  @@index([userId, createdAt])
  @@unique([userId, idempotencyKey])
}

model Entry {
  id                  String             @id @default(uuid())
  ledgerTransactionId String
  accountId           String
  amountMinor         BigInt
  direction           EntryDirection
  createdAt           DateTime           @default(now())

  ledgerTransaction   LedgerTransaction  @relation(fields: [ledgerTransactionId], references: [id], onDelete: Cascade)
  account             Account            @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId, createdAt])
  @@index([ledgerTransactionId])
}
